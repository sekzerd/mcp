# Copy to .env and fill in your credentials.

# Recommended: new console API key (sent as X-Api-Key).
DOUBAO_VOICE_API_KEY=

# Legacy console auth. Used only when DOUBAO_VOICE_API_KEY is empty.
# DOUBAO_VOICE_APP_ID=
# DOUBAO_VOICE_ACCESS_KEY=

# Optional overrides.
# DOUBAO_VOICE_BASE_URL=https://openspeech.bytedance.com
# DOUBAO_VOICE_MODEL=seed-audio-1.0
# DOUBAO_VOICE_TIMEOUT=300
# HOST=127.0.0.1
# PORT=8200
# LOG_LEVEL=INFO
