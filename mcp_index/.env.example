# Copy to .env and adjust as needed.

HOST=127.0.0.1
PORT=8100

# Registry file; relative paths resolve against mcp_index/.
# INDEX_REGISTRY=registry.json

# Root used to resolve each entry's `readme` path.
# INDEX_PROJECT_ROOT=..

# When set, write endpoints require Bearer <token> or X-Index-Token: <token>.
# INDEX_WRITE_TOKEN=

# Health probe timeout in seconds.
INDEX_HEALTH_TIMEOUT=3.0

LOG_LEVEL=INFO
